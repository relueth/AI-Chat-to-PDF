{
  "manifest_version": 3,
  "name": "AI Chat to PDF (Kimi / Gemini / Claude / ChatGPT / Grok / DeepSeek / Meta AI)",
  "version": "1.0.0",
  "description": "Kimi / Gemini / Gemini Notebook (NotebookLM) / Claude / ChatGPT / Genspark / Grok / Sakana AI / DeepSeek / Meta AI のAI会話を、数式のレイアウトを崩さずにPDFとして保存します。",
  "default_locale": "ja",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kimi.moonshot.cn/*",
        "https://*.kimi.moonshot.cn/*",
        "https://kimi.com/*",
        "https://*.kimi.com/*",
        "https://kimi.ai/*",
        "https://*.kimi.ai/*",
        "https://notebook.google.com/*",
        "https://*.notebook.google.com/*",
        "https://notebooklm.google.com/*",
        "https://*.notebooklm.google.com/*",
        "https://notebooklm.google/*",
        "https://*.notebooklm.google/*",
        "https://notebook.cloud.google.com/*",
        "https://*.notebook.cloud.google.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://www.genspark.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://grok.com/*",
        "https://www.grok.com/*",
        "https://x.com/i/grok*",
        "https://x.com/grok*",
        "https://twitter.com/i/grok*",
        "https://chat.sakana.ai/*",
        "https://*.chat.sakana.ai/*",
        "https://sakana.ai/*",
        "https://*.sakana.ai/*",
        "https://console.sakana.ai/*",
        "https://*.console.sakana.ai/*",
        "https://app.sakana.ai/*",
        "https://*.app.sakana.ai/*",
        "https://chat.deepseek.com/*",
        "https://*.deepseek.com/*",
        "https://deepseek.com/*",
        "https://www.meta.ai/*",
        "https://meta.ai/*",
        "https://*.meta.ai/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "activeTab", "tabs", "scripting"],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "export/export.html",
        "lib/katex/*",
        "lib/katex/fonts/*",
        "lib/mathjax/*",
        "lib/jszip/*",
        "lib/jspdf/*",
        "lib/html2canvas/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
