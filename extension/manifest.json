{
  "manifest_version": 3,
  "name": "AI Chat to PDF (Kimi / Gemini / Claude / ChatGPT / Grok)",
  "version": "1.0.0",
  "description": "Kimi / Gemini / Claude / ChatGPT / Genspark / Grok のAI会話を、数式のレイアウトを崩さずにPDFとして保存します。",
  "default_locale": "ja",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kimi.moonshot.cn/*",
        "https://www.kimi.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://www.genspark.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://grok.com/*",
        "https://www.grok.com/*",
        "https://x.com/i/grok*",
        "https://x.com/grok*",
        "https://twitter.com/i/grok*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "host_permissions": [
    "https://kimi.moonshot.cn/*",
    "https://www.kimi.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://www.genspark.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://grok.com/*",
    "https://www.grok.com/*",
    "https://x.com/i/grok*",
    "https://x.com/grok*",
    "https://twitter.com/i/grok*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["export/export.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
